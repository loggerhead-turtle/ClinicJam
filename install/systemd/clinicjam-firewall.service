[Unit]
Description=ClinicJam walled-garden firewall (nftables)
After=clinicjam-network.service
Requires=clinicjam-network.service
# The wall must be up before any guest can associate.
Before=clinicjam-hostapd.service clinicjam-dnsmasq.service clinicjam-dns-nest.service clinicjam-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /etc/clinicjam/nftables.conf
ExecStart=/usr/sbin/nft -f /etc/clinicjam/nftables.conf
ExecStartPost=/usr/local/sbin/clinicjam-fw sync
ExecReload=/usr/sbin/nft -f /etc/clinicjam/nftables.conf
ExecReload=/usr/local/sbin/clinicjam-fw sync

[Install]
WantedBy=multi-user.target
