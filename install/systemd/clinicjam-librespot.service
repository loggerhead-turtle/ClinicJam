[Unit]
Description=ClinicJam Spotify Connect endpoint (librespot -> PCM fifo)
# The web service holds the read end of the fifo open; start after it so
# librespot's writes have somewhere to go.
After=clinicjam-web.service
Wants=clinicjam-web.service

[Service]
User=clinicjam
Group=clinicjam
EnvironmentFile=/etc/clinicjam/librespot.env
ExecStart=/usr/bin/librespot \
    --name "${DEVICE_NAME}" \
    --backend pipe \
    --device /run/clinicjam/audio.fifo \
    --bitrate 320 \
    --format S16 \
    --onevent /opt/clinicjam/bin/onevent.sh \
    --cache /var/lib/clinicjam/librespot-cache \
    --cache-size-limit 1G \
    --initial-volume 100 \
    --volume-ctrl fixed
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
