[Unit]
Description=ClinicJam Spotify Connect player (librespot -> PCM fifo)
# The web service holds the read end of the fifo open; start after it so
# librespot's writes have somewhere to go.
After=clinicjam-web.service network-online.target
Wants=clinicjam-web.service network-online.target

[Service]
User=clinicjam
Group=clinicjam
EnvironmentFile=/etc/clinicjam/librespot.env
ExecStart=/opt/clinicjam/bin/run-librespot.sh
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/clinicjam /run/clinicjam
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=400M

[Install]
WantedBy=multi-user.target
