[Unit]
Description=ClinicJam web server (guest app, admin panel, audio stream)
After=network.target clinicjam-network.service

[Service]
User=clinicjam
Group=clinicjam
Environment=CLINICJAM_CONFIG=/etc/clinicjam/config.toml
WorkingDirectory=/opt/clinicjam/server
ExecStart=/opt/clinicjam/venv/bin/python -m clinicjam.main
Restart=always
RestartSec=3

# Resource ceiling (tuned for a Pi 4 2GB — generous headroom, not a tight
# budget): covers this process plus the ffmpeg encoder it spawns as a
# child, while leaving room for hostapd/dnsmasq/librespot alongside it.
MemoryHigh=300M
MemoryMax=400M
CPUQuota=150%

# Sandboxing: this process only ever needs to read its own install, read
# config, and read/write its own state and runtime dirs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/clinicjam /run/clinicjam

[Install]
WantedBy=multi-user.target
