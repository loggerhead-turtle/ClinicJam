[Unit]
Description=ClinicJam DHCP/DNS for the jam network (dnsmasq)
After=clinicjam-network.service
Requires=clinicjam-network.service

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/clinicjam/dnsmasq.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
