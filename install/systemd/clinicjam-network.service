[Unit]
Description=ClinicJam jam-network interface (static IPs, bridge)
Before=clinicjam-firewall.service clinicjam-hostapd.service clinicjam-dnsmasq.service clinicjam-dns-nest.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/clinicjam/bin/setup-ap-interface.sh

[Install]
WantedBy=multi-user.target
